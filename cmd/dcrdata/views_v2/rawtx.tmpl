{{define "rawtx" -}}
<!DOCTYPE html>
<html lang="en">
{{template "v2-head" "Decode / Broadcast Transaction"}}
<body data-controller="theme rawtx">
<div class="app">
  {{template "v2-sidebar" .}}
  <div class="main">
    {{template "v2-topbar" .}}
    <main class="content">
      <div class="page-head">
        <p class="eyebrow">Decred · Tools</p>
        <h1>Decode / Broadcast</h1>
        <p class="text-muted" style="margin-top:var(--sp-2);max-width:720px">Paste a full, hexadecimal-encoded Decred transaction to inspect its decoded structure, or broadcast it to the network through this node.</p>
      </div>

      <div class="card" style="padding:var(--sp-6)">
        <div class="field">
          <label for="rawtxInput">Raw transaction (hex)</label>
          <textarea id="rawtxInput" class="mono" rows="6" autofocus autocomplete="off" spellcheck="false"
            data-rawtx-target="hex" data-action="keydown->rawtx#keydown"
            placeholder="0100000001…"></textarea>
          <p class="field-hint">Tip: press Ctrl/⌘ + Enter to decode.</p>
        </div>
        <div class="toolbar" style="margin-top:var(--sp-4)">
          <button type="button" class="btn btn-primary" data-action="rawtx#decode">Decode</button>
          <button type="button" class="btn" data-action="rawtx#broadcast">Broadcast</button>
          <span class="text-muted" data-rawtx-target="status" hidden></span>
        </div>
      </div>

      <p class="section-title" data-rawtx-target="header">Decoded transaction</p>
      <pre class="code-block" data-rawtx-target="output" hidden></pre>
    </main>
  </div>
</div>
</body>
</html>
{{- end}}
