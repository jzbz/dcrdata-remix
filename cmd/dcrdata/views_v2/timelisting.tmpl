{{define "timelisting" -}}
<!DOCTYPE html>
<html lang="en">
{{template "v2-head" (printf "Blocks by %s" .TimeGrouping)}}
<body data-controller="theme">
<div class="app">
  {{template "v2-sidebar" .}}
  <div class="main">
    {{template "v2-topbar" .}}
    <main class="content">
      <div class="page-head"><p class="eyebrow">Decred Mainnet</p><h1>Blocks by {{.TimeGrouping}}</h1></div>
      {{if .Data}}
      <div class="panel"><div class="table-scroll">
        <table class="data-table">
          <thead><tr><th>Period</th><th>End Height</th><th class="hide-sm">Blocks</th><th class="hide-sm">Txns</th><th class="hide-sm">Votes</th><th class="hide-sm">Tickets</th><th>Size</th><th>End Time (UTC)</th></tr></thead>
          <tbody>
            {{range .Data}}
            <tr>
              <td class="num">{{.FormattedStartTime}}</td>
              <td><a class="height-link" href="/block/{{.EndBlock}}">{{intComma .EndBlock}}</a></td>
              <td class="hide-sm num">{{intComma .BlocksCount}}</td>
              <td class="hide-sm num">{{intComma .Transactions}}</td>
              <td class="hide-sm chip" data-kind="votes">{{intComma .Voters}}</td>
              <td class="hide-sm chip" data-kind="tickets">{{intComma .FreshStake}}</td>
              <td class="num">{{.FormattedSize}}</td>
              <td class="mono">{{.FormattedEndTime}}</td>
            </tr>
            {{end}}
          </tbody>
        </table>
      </div></div>
      {{if len .Pages}}<div class="pager" style="margin-top:var(--sp-4)">{{range .Pages}}{{if eq .Link ""}}<span>{{.Str}}</span>{{else}}<a href="{{.Link}}"{{if .Active}} class="active"{{end}}>{{.Str}}</a>{{end}}{{end}}</div>{{end}}
      {{else}}<div class="alert">No data found.</div>{{end}}
    </main>
  </div>
</div>
</body>
</html>
{{end}}
