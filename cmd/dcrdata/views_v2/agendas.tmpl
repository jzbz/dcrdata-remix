{{define "agendas" -}}
<!DOCTYPE html>
<html lang="en">
{{template "v2-head" "Consensus Agendas"}}
<body data-controller="theme">
<div class="app">
  {{template "v2-sidebar" .}}
  <div class="main">
    {{template "v2-topbar" .}}
    <main class="content">
      <div class="page-head"><p class="eyebrow">Decred Mainnet</p><h1>Consensus agendas</h1></div>
      {{if .Agendas}}
      <div class="prop-grid">
        {{range .Agendas}}
        <div class="card prop-card">
          <div class="prop-head">
            <a class="prop-name link" href="/v2/agenda/{{.ID}}">{{.ID}}</a>
            <span class="tag" data-kind="ticket">{{.Status.String}}</span>
          </div>
          <p class="text-muted" style="font-size:13px">{{.Description}}</p>
          <div class="gauge" style="margin-top:var(--sp-3)"><div class="gauge-fill" style="width:{{printf "%.1f" (x100 .QuorumProgress)}}%"></div></div>
          <div class="sub" style="margin-top:var(--sp-2)">Quorum progress {{printf "%.1f" (x100 .QuorumProgress)}}% · vote v{{.VoteVersion}}</div>
        </div>
        {{end}}
      </div>
      {{else}}<div class="alert">No consensus agendas found.</div>{{end}}
    </main>
  </div>
</div>
</body>
</html>
{{end}}
