{{define "charts" -}}
<!DOCTYPE html>
<html lang="en">
{{template "v2-head" (dict "Title" "Charts" "Data" .)}}
<body data-controller="theme">
<div class="app">
  {{template "v2-sidebar" .}}
  <div class="main">
    {{template "v2-topbar" .}}
    <main class="content">
      <div class="page-head">
        <p class="eyebrow">Decred {{$.NetName}} · Charts</p>
        <h1>Charts</h1>
        <p class="sub">Select a chart for an interactive view.</p>
      </div>

      <div class="chart-grid">
        <a class="card chart-card" href="/charts/coin-supply">
          <div class="chart-head"><span class="k">Coin Supply</span></div>
          <div class="chart-body" data-controller="chart"
               data-chart-url-value="/api/chart/coin-supply?bin=day&axis=time"
               data-chart-ykey-value="supply" data-chart-color-value="#2ED6A1"></div>
        </a>
        <a class="card chart-card" href="/charts/hashrate">
          <div class="chart-head"><span class="k">Hashrate</span></div>
          <div class="chart-body" data-controller="chart"
               data-chart-url-value="/api/chart/hashrate?bin=day&axis=time"
               data-chart-ykey-value="rate" data-chart-color-value="#36C5E0"></div>
        </a>
        <a class="card chart-card" href="/charts/tx-count">
          <div class="chart-head"><span class="k">Transaction Count</span></div>
          <div class="chart-body" data-controller="chart"
               data-chart-url-value="/api/chart/tx-count?bin=day&axis=time"
               data-chart-ykey-value="count" data-chart-color-value="#9B8CFF"></div>
        </a>
        <a class="card chart-card" href="/charts/fees">
          <div class="chart-head"><span class="k">Fees</span></div>
          <div class="chart-body" data-controller="chart"
               data-chart-url-value="/api/chart/fees?bin=day&axis=time"
               data-chart-ykey-value="fees" data-chart-color-value="#F5A623"></div>
        </a>
        <a class="card chart-card" href="/charts/ticket-price">
          <div class="chart-head"><span class="k">Ticket Price</span></div>
          <div class="chart-body" data-controller="chart"
               data-chart-url-value="/api/chart/ticket-price?bin=window&axis=time"
               data-chart-ykey-value="price" data-chart-color-value="#5BA8FF"></div>
        </a>
        <a class="card chart-card" href="/charts/pow-difficulty">
          <div class="chart-head"><span class="k">PoW Difficulty</span></div>
          <div class="chart-body" data-controller="chart"
               data-chart-url-value="/api/chart/pow-difficulty?bin=window&axis=time"
               data-chart-ykey-value="diff" data-chart-color-value="#5BA8FF"></div>
        </a>
        <a class="card chart-card" href="/charts/duration-btw-blocks">
          <div class="chart-head"><span class="k">Block Time</span></div>
          <div class="chart-body" data-controller="chart"
               data-chart-url-value="/api/chart/duration-btw-blocks?bin=day&axis=time"
               data-chart-ykey-value="duration" data-chart-color-value="#36C5E0"></div>
        </a>
        <a class="card chart-card" href="/charts/privacy-participation">
          <div class="chart-head"><span class="k">Privacy Participation</span></div>
          <div class="chart-body" data-controller="chart"
               data-chart-url-value="/api/chart/privacy-participation?bin=day&axis=time"
               data-chart-ykey-value="anonymitySet" data-chart-color-value="#2ED6A1"></div>
        </a>
        <a class="card chart-card" href="/charts/stake-participation">
          <div class="chart-head"><span class="k">Staked Supply</span></div>
          <div class="chart-body" data-controller="chart"
               data-chart-url-value="/api/chart/stake-participation?bin=day&axis=time"
               data-chart-ykey-value="poolval" data-chart-ratio-value="circulation"
               data-chart-color-value="#2ED6A1"></div>
        </a>
        <a class="card chart-card" href="/charts/ticket-pool-value">
          <div class="chart-head"><span class="k">Ticket Pool Value</span></div>
          <div class="chart-body" data-controller="chart"
               data-chart-url-value="/api/chart/ticket-pool-value?bin=day&axis=time"
               data-chart-ykey-value="poolval" data-chart-color-value="#5BA8FF"></div>
        </a>
        <a class="card chart-card" href="/charts/ticket-pool-size">
          <div class="chart-head"><span class="k">Ticket Pool Size</span></div>
          <div class="chart-body" data-controller="chart"
               data-chart-url-value="/api/chart/ticket-pool-size?bin=day&axis=time"
               data-chart-ykey-value="count" data-chart-color-value="#5BA8FF"></div>
        </a>
        <a class="card chart-card" href="/charts/missed-votes">
          <div class="chart-head"><span class="k">Missed Votes</span></div>
          <div class="chart-body" data-controller="chart"
               data-chart-url-value="/api/chart/missed-votes?bin=window&axis=time"
               data-chart-ykey-value="missed" data-chart-color-value="#F5A623"></div>
        </a>
        <a class="card chart-card" href="/charts/chainwork">
          <div class="chart-head"><span class="k">Chainwork</span></div>
          <div class="chart-body" data-controller="chart"
               data-chart-url-value="/api/chart/chainwork?bin=day&axis=time"
               data-chart-ykey-value="work" data-chart-color-value="#5BA8FF"></div>
        </a>
        <a class="card chart-card" href="/charts/block-size">
          <div class="chart-head"><span class="k">Block Size</span></div>
          <div class="chart-body" data-controller="chart"
               data-chart-url-value="/api/chart/block-size?bin=day&axis=time"
               data-chart-ykey-value="size" data-chart-color-value="#9B8CFF"></div>
        </a>
        <a class="card chart-card" href="/charts/blockchain-size">
          <div class="chart-head"><span class="k">Blockchain Size</span></div>
          <div class="chart-body" data-controller="chart"
               data-chart-url-value="/api/chart/blockchain-size?bin=day&axis=time"
               data-chart-ykey-value="size" data-chart-color-value="#9B8CFF"></div>
        </a>
      </div>
    </main>
  </div>
</div>
</body>
</html>
{{end}}
