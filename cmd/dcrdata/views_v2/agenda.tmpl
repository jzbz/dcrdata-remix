{{define "agenda" -}}
<!DOCTYPE html>
<html lang="en">
{{template "v2-head" (dict "Title" "Agenda" "Data" .)}}
<body data-controller="theme">
<div class="app">
  {{template "v2-sidebar" .}}
  <div class="main">
    {{template "v2-topbar" .}}
    <main class="content">
      {{with .Ai}}
      <div class="page-head">
        <p class="eyebrow">Decred {{$.NetName}} · Agenda</p>
        <h1 style="display:flex;align-items:center;gap:var(--sp-3);flex-wrap:wrap">{{.ID}} <span class="tag" data-kind="ticket">{{.Status.String}}</span></h1>
        <p class="text-muted" style="margin-top:var(--sp-2)">{{.Description}}</p>
      </div>
      {{end}}

      <div class="stat-grid">
        <div class="card stat"><div class="k">Total Votes</div><div class="v">{{intComma .TotalVotes}}</div></div>
        <div class="card stat"><div class="k">Quorum</div><div class="v">{{intComma .QuorumVotes}}</div><div class="sub">of {{intComma .RuleChangeQ}} required</div></div>
        <div class="card stat"><div class="k">Blocks Left</div><div class="v">{{intComma .BlocksLeft}}</div></div>
        <div class="card stat"><div class="k">Time Remaining</div><div class="v" style="font-size:18px">{{if .TimeRemaining}}{{.TimeRemaining}}{{else}}&mdash;{{end}}</div></div>
      </div>

      <p class="section-title">Vote choices</p>
      <div class="panel" style="padding:var(--sp-5)">
        {{range .Ai.Choices}}
        <div style="margin-bottom:var(--sp-4)">
          <div style="display:flex;justify-content:space-between;font-size:14px">
            <span>{{.Description}}</span>
            <span class="mono">{{intComma .Count}} · {{printf "%.2f" (x100 .Progress)}}%</span>
          </div>
          <div class="gauge" style="margin-top:var(--sp-2)">
            <div class="gauge-fill" style="width:{{printf "%.1f" (x100 .Progress)}}%;{{if .IsNo}}background:var(--down){{else if .IsAbstain}}background:var(--dim){{else}}background:var(--turquoise){{end}}"></div>
          </div>
        </div>
        {{end}}
      </div>
    </main>
  </div>
</div>
</body>
</html>
{{end}}
