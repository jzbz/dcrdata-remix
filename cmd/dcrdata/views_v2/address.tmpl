{{define "address" -}}
<!DOCTYPE html>
<html lang="en">
{{template "v2-head" (dict "Title" "Address" "Data" .)}}
<body data-controller="theme clipboard age">
<div class="app">
  {{template "v2-sidebar" .}}
  <div class="main">
    {{template "v2-topbar" .}}
    <main class="content">
      {{with .Data}}
      <div class="page-head">
        <p class="eyebrow">Decred {{$.NetName}} · Address</p>
        <h1 style="font-size:24px">Address</h1>
        <div class="hash" style="margin-top:var(--sp-2); color:var(--text-2)">
          <span class="text">{{.Address}}</span>
          <button class="copy" data-action="clipboard#copy" data-clipboard-text="{{.Address}}" title="Copy address">⧉</button>
        </div>
      </div>

      <div class="stat-grid">
        {{- /* Use the full-history Balance totals, not the page-scoped
        AmountReceived/AmountSent/AmountUnspent sums from ReduceAddressHistory,
        which only cover the transactions on the current page. */ -}}
        {{with .Balance}}
        {{- /* dcr, not threeSigFigs: balances are the address page's payload
        and must be exact, never compressed to k/M magnitudes. */ -}}
        <div class="card stat"><div class="k">Balance</div><div class="v">{{dcrHTML .TotalUnspent}}</div><div class="sub">DCR</div></div>
        <div class="card stat"><div class="k">Received</div><div class="v">{{dcrHTML (add .TotalSpent .TotalUnspent)}}</div><div class="sub">DCR</div></div>
        <div class="card stat"><div class="k">Sent</div><div class="v">{{dcrHTML .TotalSpent}}</div><div class="sub">DCR</div></div>
        {{end}}
        <div class="card stat"><div class="k">Transactions</div><div class="v">{{intComma .TxnCount}}</div></div>
        {{if .Balance}}<div class="card stat"><div class="k">Unspent Outputs</div><div class="v">{{intComma .Balance.NumUnspent}}</div></div>{{end}}
      </div>

      <p class="section-title">Balance over time</p>
      <div class="panel" style="padding:var(--sp-5)">
        <div class="chart-body" style="height:200px" data-controller="chart"
             data-chart-url-value="/api/address/{{.Address}}/amountflow/day"
             data-chart-ykey-value="net"
             data-chart-accumulate-value="true"
             data-chart-color-value="#2ED6A1"></div>
      </div>

      <p class="section-title">Transaction history</p>
      {{if .Transactions}}
      <div class="panel">
        <div class="table-scroll">
        <table class="data-table">
          <thead>
            <tr>
              <th>Transaction</th>
              <th class="hide-sm">Type</th>
              <th>Amount</th>
              <th class="hide-sm">Confirmations</th>
              <th>Age</th>
              <th>Time (UTC)</th>
            </tr>
          </thead>
          <tbody>
            {{range .Transactions}}
            <tr>
              <td><a class="height-link" href="/tx/{{.TxID}}">{{.TxID}}</a></td>
              <td class="hide-sm"><span class="tag" data-kind="regular">{{.TxType}}</span></td>
              <td class="num">{{if .IsFunding}}<span class="amt-in">+{{coin .ReceivedTotal}}</span>{{else}}<span class="amt-out">&minus;{{coin .SentTotal}}</span>{{end}}</td>
              <td class="hide-sm num">{{.Confirmations}}</td>
              <td class="num text-muted" data-age-target="age" data-age="{{.Time.UNIX}}"></td>
              <td class="mono">{{.Time.DatetimeWithoutTZ}}</td>
            </tr>
            {{end}}
          </tbody>
        </table>
        </div>
      </div>
      {{else}}
      <div class="alert">No transactions found for this address.</div>
      {{end}}

      {{if len $.Pages}}
      <div class="pager" style="margin-top: var(--sp-4)">
        {{range $.Pages}}
          {{if eq .Link ""}}<span>{{.Str}}</span>{{else}}<a href="{{.Link}}"{{if .Active}} class="active"{{end}}>{{.Str}}</a>{{end}}
        {{end}}
      </div>
      {{end}}
      {{end}}{{/* with .Data */}}
    </main>
  </div>
</div>
</body>
</html>
{{end}}
