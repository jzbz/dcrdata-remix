{{define "attackcost" -}}
<!DOCTYPE html>
<html lang="en">
{{template "v2-head" "Majority Attack Cost Calculator"}}
<body data-controller="theme attackcost"
  data-attackcost-height="{{.Height}}"
  data-attackcost-hashrate="{{.HashRate}}"
  data-attackcost-dcrprice="{{.DCRPrice}}"
  data-attackcost-ticket-price="{{.TicketPrice}}"
  data-attackcost-ticket-pool-value="{{.TicketPoolValue}}"
  data-attackcost-ticket-pool-size="{{.TicketPoolSize}}"
  data-attackcost-coin-supply="{{.CoinSupply}}">
<div class="app">
  {{template "v2-sidebar" .}}
  <div class="main">
    {{template "v2-topbar" .}}
    <main class="content">
      <div class="page-head">
        <p class="eyebrow">Decred {{.NetName}} · Security</p>
        <h1>Majority Attack Cost</h1>
        <p class="text-muted" style="margin-top:var(--sp-2);max-width:760px">Estimate what a 51% attack on Decred's hybrid PoW/PoS chain would cost. Move the slider or adjust the parameters; everything recalculates live.</p>
      </div>

      {{- /* CURRENT NETWORK PARAMETERS */ -}}
      <div class="stat-grid">
        <div class="card stat"><div class="k">Best Block</div><div class="v" data-attackcost-target="blockHeight">{{intComma .Height}}</div></div>
        <div class="card stat"><div class="k">Hashrate</div><div class="v"><span data-attackcost-target="actualHashRate">0</span> <span class="sub">Ph/s</span></div></div>
        <div class="card stat"><div class="k">Ticket Pool Size</div><div class="v" data-attackcost-target="ticketPoolSizeLabel">0</div></div>
        <div class="card stat"><div class="k">Ticket Price</div><div class="v"><span data-attackcost-target="ticketPrice">0</span> <span class="sub">DCR</span></div></div>
      </div>

      {{- /* CHART + SLIDER */ -}}
      <div class="card" style="padding:var(--sp-5);margin-top:var(--sp-5)">
        <p class="section-title" style="margin-top:0">Hash power vs. stake controlled</p>
        <div data-attackcost-target="graph" style="width:100%;height:200px"></div>
        <input class="slider" type="range" min="0.01" max="0.99" step="0.005" value="0.5"
          data-attackcost-target="attackPercent" data-action="input->attackcost#updateSliderData">
        <p class="ac-line-item">If an attacker controls <span class="fw" data-attackcost-target="tickets">0</span> and
          <span class="fw" data-attackcost-target="internalHash">0</span> hashrate, they can generate blocks at the
          same average speed as the honest network.</p>
      </div>

      {{- /* ADJUSTABLE PARAMETERS */ -}}
      <p class="section-title">Adjustable parameters</p>
      <div class="card" style="padding:var(--sp-5)">
        <div class="stat-grid">
          <div class="kv"><span class="k">Attack Time</span><span class="v"><input class="num-input" type="number" step="1" min="1" max="1000" value="1" data-attackcost-target="attackPeriod" data-action="change->attackcost#updateAttackTime"> <span class="text-muted" data-attackcost-target="durationUnit">hour</span></span></div>
          <div class="kv"><span class="k">Electricity Cost</span><span class="v"><input class="num-input" type="number" step="0.1" min="0.1" max="1000" value="0.1" data-attackcost-target="kwhRate" data-action="change->attackcost#updateKwhRate"> <span class="text-muted">USD/kWh</span></span></div>
          <div class="kv"><span class="k">Exchange Rate</span><span class="v"><input class="num-input" type="number" step="0.01" min="0.01" max="1000" value="20" data-attackcost-target="priceDCR" data-action="change->attackcost#updatePrice"> <span class="text-muted">USD/DCR</span></span></div>
          <div class="kv"><span class="k">Attack Type</span><span class="v"><select class="num-input" data-attackcost-target="attackType" data-action="attackcost#chooseAttackType"><option value="external">External</option><option value="internal">Internal</option></select></span></div>
        </div>
      </div>

      <div class="chart-grid" style="display:grid;grid-template-columns:1fr 1fr;gap:var(--gap);margin-top:var(--sp-5)">
        {{- /* POW ATTACK */ -}}
        <div class="card" style="padding:var(--sp-5)">
          <p class="section-title" style="margin-top:0">PoW Attack</p>
          <div class="ac-line-item" style="display:flex;align-items:center;gap:var(--sp-2)">Mining device:
            <select class="num-input" data-attackcost-target="device" data-action="attackcost#chooseDevice">
              <option data-attackcost-target="deviceDesc" value="0">DCR5</option>
              <option data-attackcost-target="deviceDesc" value="1">D1</option>
            </select>
          </div>
          <div class="ac-line-item">A <input class="num-input" type="number" step="0.01" min="0.01" max="10000000" value="100" data-attackcost-target="targetPow" data-action="change->attackcost#updateTargetPow">%
            <span data-attackcost-target="internalAttackText">PoW attack would need <span class="fw"><span data-attackcost-target="targetHashRate">0</span> Ph/s</span>.</span>
            <span data-attackcost-target="externalAttackText" hidden>PoW attack requires adding <span class="fw"><span data-attackcost-target="additionalHashRate">0</span> Ph/s</span> to the existing <span class="fw"><span data-attackcost-target="actualHashRate">0</span> Ph/s</span> network hashrate.</span>
          </div>
          <div class="ac-line-item" data-attackcost-target="externalAttackText" hidden>New network hashrate will be <span class="fw"><span data-attackcost-target="newHashRate">0</span> Ph/s</span>.</div>
          <div class="ac-line-item">To acquire a <span class="fw"><span data-attackcost-target="targetHashRate">0</span> Ph/s</span> hashrate, it would take <span class="fw" data-attackcost-target="countDevice">0</span> <span data-attackcost-target="deviceName">&mdash;</span> at a cost of <span class="fw">$<span data-attackcost-target="totalDeviceCost">0</span> USD</span> to buy <span data-attackcost-target="devicePronoun">them</span>.</div>
          <div class="ac-line-item">Electricity consumed by <span class="fw" data-attackcost-target="countDevice">0</span> <span data-attackcost-target="deviceName">&mdash;</span> in <span data-attackcost-target="durationLongDesc">0</span> is <span class="fw"><span data-attackcost-target="totalKwh">0</span> kWh</span>.</div>
          <div class="ac-line-item">Cost of <span data-attackcost-target="durationLongDesc">0</span> electricity for <span class="fw" data-attackcost-target="countDevice">0</span> <span data-attackcost-target="deviceName">&mdash;</span> is <span class="fw">$<span data-attackcost-target="totalElectricity">0</span> USD</span>.</div>
          <div class="ac-line-item">Facilities and cooling are estimated at <input class="num-input" type="number" step="1" min="1" max="100" value="5" data-attackcost-target="otherCosts" data-action="change->attackcost#updateOtherCosts">% of the miner cost<span data-attackcost-target="deviceSuffix">s</span> — an extra <span class="fw">$<span data-attackcost-target="otherCostsValue">0</span> USD</span>.</div>
          <div class="ac-line-item" style="margin-top:var(--sp-4)">Total PoW attack cost: <span class="fw">$<span data-attackcost-target="totalPow">0</span> USD</span>.</div>
        </div>

        {{- /* POS ATTACK */ -}}
        <div class="card" style="padding:var(--sp-5)">
          <p class="section-title" style="margin-top:0">PoS Attack</p>
          <div data-attackcost-target="internalAttackPosText" hidden>
            <div class="ac-line-item">Current total staked is <span class="fw"><span data-attackcost-target="ticketPoolValue">0</span> DCR</span>.</div>
            <div class="ac-line-item">An internal <input class="num-input" type="number" step="0.5" min="1" max="99" value="50" data-attackcost-target="targetPos" data-action="change->attackcost#updateTargetPos">% PoS attack would need <span class="fw"><span data-attackcost-target="ticketSizeAttack">0</span> tickets</span>.</div>
            <div class="ac-line-item"><span class="fw"><span data-attackcost-target="ticketPoolAttack">0</span> DCR</span> is needed for the attack (<span data-attackcost-target="ticketPoolValue">0</span> DCR &times; <span data-attackcost-target="attackPosPercentAmountLabel">0</span>%).</div>
            <div class="ac-line-item">Total PoS attack cost: <span class="fw">$<span data-attackcost-target="totalPos">0</span> USD</span> (<span data-attackcost-target="totalDCRPosLabel">0</span> DCR &times; $<span data-attackcost-target="dcrPriceLabel">0</span> USD/DCR).</div>
          </div>
          <div data-attackcost-target="externalAttackPosText" hidden>
            <div class="ac-line-item">Current total staked is <span class="fw"><span data-attackcost-target="ticketPoolValue">0</span> DCR</span>.</div>
            <div class="ac-line-item">An external <input class="num-input" type="number" step="0.5" min="1" max="99" value="50" data-attackcost-target="targetPos" data-action="change->attackcost#updateTargetPos">% PoS attack would add <span class="fw"><span data-attackcost-target="additionalDcr">0</span> DCR</span> to the total staked.</div>
            <div class="ac-line-item">New total staked will be <span class="fw"><span data-attackcost-target="newTicketPoolValue">0</span> DCR</span>.</div>
            <div class="ac-line-item" data-attackcost-target="attackNotPossibleWrapperDiv" hidden style="color:var(--down)">Attack not possible. Total coin supply is <span class="fw"><span data-attackcost-target="coinSupply">0</span> DCR</span>.</div>
            <div class="ac-line-item" data-attackcost-target="projectedPriceDiv">The projected ticket price is <span class="fw"><span data-attackcost-target="projectedTicketPrice">0</span> DCR</span> (a <span class="fw"><span data-attackcost-target="projectedTicketPriceIncrease">0</span>%</span> <span data-attackcost-target="projectedTicketPriceSign">change</span>).</div>
            <div class="ac-line-item">Total PoS attack cost: <span class="fw">$<span data-attackcost-target="totalPos">0</span> USD</span> (<span data-attackcost-target="totalDCRPosLabel">0</span> DCR &times; $<span data-attackcost-target="dcrPriceLabel">0</span> USD/DCR).</div>
          </div>
        </div>
      </div>

      {{- /* SUMMARY */ -}}
      <div class="attack-total">
        <span>Total attack cost:</span>
        <span data-attackcost-target="totalAttackCostContainer">$<span class="total-val" data-attackcost-target="total">0</span> USD</span>
      </div>
    </main>
  </div>
</div>
</body>
</html>
{{- end}}
