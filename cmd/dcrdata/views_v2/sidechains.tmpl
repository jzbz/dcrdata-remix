{{define "sidechains" -}}
<!DOCTYPE html>
<html lang="en">
{{template "v2-head" "Side Chains"}}
<body data-controller="theme">
<div class="app">
  {{template "v2-sidebar" .}}
  <div class="main">
    {{template "v2-topbar" .}}
    <main class="content">
      <div class="page-head"><p class="eyebrow">Decred Mainnet</p><h1>Side chain blocks</h1></div>
      {{if .Data}}
      <div class="panel"><div class="table-scroll">
        <table class="data-table">
          <thead><tr><th>Height</th><th>Hash</th><th>Previous</th><th>Status</th></tr></thead>
          <tbody>
            {{range .Data}}
            <tr>
              <td><a class="height-link" href="/v2/block/{{.Hash}}">{{.Height}}</a></td>
              <td class="mono">{{.Hash}}</td>
              <td class="mono text-muted">{{.PrevHash}}</td>
              <td>{{if .IsValid}}<span class="badge">approved</span>{{else}}<span class="tag" data-kind="revoke">disapproved</span>{{end}}</td>
            </tr>
            {{end}}
          </tbody>
        </table>
      </div></div>
      {{else}}<div class="alert">No side chain blocks found.</div>{{end}}
    </main>
  </div>
</div>
</body>
</html>
{{end}}
