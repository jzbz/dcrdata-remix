{{define "proposals" -}}
<!DOCTYPE html>
<html lang="en">
{{template "v2-head" (dict "Title" "Proposals" "Data" .)}}
<body data-controller="theme">
<div class="app">
  {{template "v2-sidebar" .}}
  <div class="main">
    {{template "v2-topbar" .}}
    <main class="content">
      <div class="page-head" style="display:flex;justify-content:space-between;align-items:flex-end;flex-wrap:wrap;gap:var(--sp-3)">
        <div><p class="eyebrow">Decred Politeia</p><h1>Proposals</h1></div>
        {{if gt .TotalCount 0}}<span class="rowcount">{{intComma (add .Offset 1)}} &ndash; {{intComma (add .Offset (int64 (len .Proposals)))}} of {{intComma .TotalCount}}</span>{{end}}
      </div>
      {{if .Proposals}}
      <div class="prop-grid">
        {{range .Proposals}}
        <div class="card prop-card">
          <div class="prop-head">
            <a class="prop-name link" href="/proposal/{{.Token}}">{{.Name}}</a>
            <span class="tag" data-kind="ticket">{{index $.VotesStatus .VoteStatus}}</span>
          </div>
          <div class="prop-stats">
            <span class="text-muted">by {{.Username}}</span>
            <span class="text-muted">{{intComma .TotalVotes}} votes</span>
            <span class="text-muted">{{.CommentsCount}} comments</span>
          </div>
        </div>
        {{end}}
      </div>
      <div class="pager" style="margin-top:var(--sp-5)">
        {{if gt .Offset 0}}<a href="/proposals?offset={{subtract .Offset .Limit}}&rows={{.Limit}}">Newer</a>{{end}}
        {{if lt (add .Offset .Limit) .TotalCount}}<a href="/proposals?offset={{add .Offset .Limit}}&rows={{.Limit}}">Older</a>{{end}}
      </div>
      {{else}}<div class="alert">No proposals available (Politeia integration disabled or empty).</div>{{end}}
    </main>
  </div>
</div>
</body>
</html>
{{end}}
